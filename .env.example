# =============================================================================
# STONEY PLATFORM — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` or any file containing real credentials.
#
# Required variables are marked with (REQUIRED).
# Optional variables are marked with (OPTIONAL).
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL via Prisma
# -----------------------------------------------------------------------------
# (REQUIRED) Full Neon PostgreSQL connection string with SSL.
DATABASE_URL=


# -----------------------------------------------------------------------------
# FIREBASE CLIENT SDK — Public (safe to expose to the browser)
# These variables are prefixed NEXT_PUBLIC_ and embedded into the client bundle.
# Obtain all values from your Firebase project console:
# https://console.firebase.google.com → Project Settings → General → Your apps
# -----------------------------------------------------------------------------

# (REQUIRED) Firebase Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=

# (REQUIRED) Firebase Auth Domain (e.g., your-project.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# (REQUIRED) Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# (OPTIONAL) Firebase Storage Bucket (e.g., your-project.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# (OPTIONAL) Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# (REQUIRED) Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=

# (OPTIONAL) Firebase Measurement ID (Google Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK — Server-only (NEVER expose to the browser)
# Used by src/lib/firebase/admin.ts to verify session cookies server-side.
# Obtain from Firebase console → Project Settings → Service accounts
#   → Generate new private key
#
# Choose ONE of the three credential strategies below:
# -----------------------------------------------------------------------------

# Strategy 1 (recommended for production): Full service account JSON as a
# single-line string. Paste the entire downloaded JSON with newlines escaped.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Strategy 2 (recommended for local dev / CI): Individual credential fields.
# All three must be set together; leave blank to use Strategy 1 or 3 instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Private key typically contains literal newlines. On most platforms,
# wrap in double quotes and use \n. On some (e.g., Vercel), use the raw value.
FIREBASE_PRIVATE_KEY=

# =============================================================================
# STONEY PLATFORM — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` or any file containing real credentials.
#
# Required variables are marked with (REQUIRED).
# Optional variables are marked with (OPTIONAL).
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL via Prisma
# -----------------------------------------------------------------------------
# (REQUIRED) Full Neon PostgreSQL connection string with SSL.
DATABASE_URL=


# -----------------------------------------------------------------------------
# FIREBASE CLIENT SDK — Public (safe to expose to the browser)
# These variables are prefixed NEXT_PUBLIC_ and embedded into the client bundle.
# Obtain all values from your Firebase project console:
# https://console.firebase.google.com → Project Settings → General → Your apps
# -----------------------------------------------------------------------------

# (REQUIRED) Firebase Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=

# (REQUIRED) Firebase Auth Domain (e.g., your-project.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# (REQUIRED) Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# (OPTIONAL) Firebase Storage Bucket (e.g., your-project.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# (OPTIONAL) Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# (REQUIRED) Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=

# (OPTIONAL) Firebase Measurement ID (Google Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK — Server-only (NEVER expose to the browser)
# Used by src/lib/firebase/admin.ts to verify session cookies server-side.
# Obtain from Firebase console → Project Settings → Service accounts
#   → Generate new private key
#
# Choose ONE of the three credential strategies below:
# -----------------------------------------------------------------------------

# Strategy 1 (recommended for production): Full service account JSON as a
# single-line string. Paste the entire downloaded JSON with newlines escaped.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Strategy 2 (recommended for local dev / CI): Individual credential fields.
# All three must be set together; leave blank to use Strategy 1 or 3 instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Private key typically contains literal newlines. On most platforms,
# wrap in double quotes and use \n. On some (e.g., Vercel), use the raw value.
FIREBASE_PRIVATE_KEY=

# Strategy 3 (GCP / Cloud Run): Path to service account JSON file on disk,
# or rely on the GCP metadata server (no value needed on Cloud Run).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# BUSINESS CONFIGURATION
# (OPTIONAL) The canonical timezone for operational boundaries (Today, This Week).
# Defaults to America/New_York if not specified.
BUSINESS_TIMEZONE=America/New_York
